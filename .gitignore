# R, RStudio and Positron
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.httr-oauth
.DS_Store

# Quarto. docs/ is the rendered site, which the publish workflow renders and
# publishes to the gh-pages branch, so it is not committed.
/.quarto/
/docs/
**/*.quarto_ipynb

# Credentials
.Renviron
.env
*.pem
*.key

# Data files. Data live outside the repository; this is a safety net, not access control.
/data-raw/
*.csv
*.xlsx
*.xls
*.rds
*.rda
*.sas7bdat
*.sas7bcat
*.xpt
*.dta
*.sav
*.parquet
*.feather
*.arrow
*.fst

# Outputs, ignored until cleared for public release.
# Remove these lines when the governing review clears the outputs (for example
# USRDS review before publication), or from the start if setup decided the outputs
# need no review before release.
# Removing them does not track tables saved as .csv or .rds: the data-format
# patterns above still hide those, so cleared tables need their own exceptions.
/tables/
# Maps: drawn by the publish workflow on every push to main and published
# with the site, so they are not committed. Run R/main.R to draw them locally.
/figures/

# Approved public files: add narrow exceptions here, never a whole format.
# Original HRSA transplant-center file used by the published maps (public)
!data/hrsa/Transplant centers.csv
